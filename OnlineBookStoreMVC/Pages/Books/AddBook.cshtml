@page
@model OnlineBookStore.Pages.Books.AddBookModel

<h2>Add Book</h2>

<form method="post">

    <input asp-for="Book.Title" />
    <br />

    <input asp-for="Book.Author" />
    <br />

    <input asp-for="Book.ISBN" />
    <br />

    <input asp-for="Book.Price" />
    <br />

    <button type="submit">
        Save
    </button>

</form>